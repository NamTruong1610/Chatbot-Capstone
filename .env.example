# Copy to .env and fill in. NFR-06: .env is gitignored; only this template is committed.
#
# Nothing here is a pipeline parameter — those live in configs/ and are read through the
# config object (CLAUDE.md rule 1). This file holds only infrastructure secrets and
# endpoints that must not be hardcoded or committed. No secrets are required for the
# Phase 0 config system; the entries below are placeholders for later phases.

# --- Serving-layer API key (FR-API-02). Set before running ingestion/crawl endpoints. ---
CHATBOT_API_KEY=

# --- Store endpoints (Phase 0 P0-7, not yet wired). Host/port defaults also live in
#     configs/ under `store`; these are only for credentialed connections. ---
# QDRANT_URL=http://localhost:6333
# REDIS_URL=redis://localhost:6379/0
# POSTGRES_DSN=postgresql://user:pass@localhost:5432/chatbot

# --- Generator endpoint (OD-3 pending). base_url is a config value, not a secret;
#     put an API key here only if the endpoint needs one. ---
# CHATBOT_LLM_API_KEY=